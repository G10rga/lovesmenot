[Unit]
Description=Loves Me Not Flask App
After=network.target

[Service]
User=g1orga
Group=g1orga
WorkingDirectory=/var/www/lovesmenot
Environment="PATH=/var/www/lovesmenot/.venv/bin"
ExecStart=/var/www/lovesmenot/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5055 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
